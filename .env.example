# Marina deployment to query
MARINA_URL=https://marina.example.com

# OpenAI-compatible LLM endpoint
LLM_BASE_URL=https://mindrouter.uidaho.edu/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Where the insight client_id and private key are persisted (mode 0600).
# Created via the in-app config UI on first run.
INSIGHT_CREDENTIALS_FILE=/var/lib/insight/insight_credentials.json

# Expected `aud` claim on the assertion JWT sent to Marina /auth/token
AUTH_TOKEN_AUDIENCE=marina

# Listen port (default 8000)
PORT=8000
